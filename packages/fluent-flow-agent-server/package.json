{
  "name": "@fluent-flow/agent-server",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluent-io/fluent-flow.git",
    "directory": "packages/fluent-flow-agent-server"
  },
  "description": "Portable agent server for Fluent Flow — connects agents to the review pipeline",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-server": "./bin/fluent-flow-agent-server.js",
    "fluent-flow-agent-server": "./bin/fluent-flow-agent-server.js",
    "fluent-flow-connector": "./bin/fluent-flow-connector.js"
  },
  "main": "src/runner.js",
  "files": [
    "bin",
    "src",
    "connector.example.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p jsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:image": "node scripts/smoke.mjs --image"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@fluent-flow/db": "0.0.1",
    "@getpaseo/protocol": "0.12.0",
    "@types/punycode": "^2.1.4",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@getpaseo/client": "0.12.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  }
}
