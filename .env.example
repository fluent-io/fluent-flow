# Fluent Flow — Required Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgres://fluentflow:password@postgres:5432/fluentflow
POSTGRES_PASSWORD=password

# GitHub App (required — the app is the only auth path)
FF_GITHUB_APP_ID=
FF_GITHUB_APP_PRIVATE_KEY=       # base64-encoded GitHub App private key (PEM)
FF_GITHUB_APP_WEBHOOK_SECRET=

# GitHub OAuth (for dashboard login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dashboard
NEXTAUTH_SECRET=          # generate with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

# Optional
MCP_AUTH_TOKEN=           # MCP endpoint auth
