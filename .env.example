# Fluent Flow — Required Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgres://fluentflow:password@postgres:5432/fluentflow
POSTGRES_PASSWORD=password

# GitHub App (required — the app is the only auth path)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=

# GitHub OAuth (for dashboard login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dashboard
NEXTAUTH_SECRET=          # generate with: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000

# Optional
GITHUB_TOKEN=             # legacy PAT, optional fallback
MCP_AUTH_TOKEN=           # MCP endpoint auth
GITHUB_WEBHOOK_SECRET=    # legacy webhook secret, optional
