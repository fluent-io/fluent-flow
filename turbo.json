{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "COLLAB_DB_TEST_DATABASE_URL",
        "COLLAB_ROUTES_TEST_DATABASE_URL",
        "COLLAB_CONNECTOR_TEST_DATABASE_URL",
        "TEST_DATABASE_URL",
        "FF_COLLAB_TEST_DB_OPTIN"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["*"],
      "cache": false,
      "persistent": true
    }
  }
}
