{
  "name": "@fluent-flow/runner",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluent-io/fluent-flow.git",
    "directory": "packages/fluent-flow-runner"
  },
  "description": "Lightweight CLI runner for Fluent Flow \u2014 connects agents to the review pipeline",
  "type": "module",
  "bin": {
    "fluent-flow-runner": "./bin/fluent-flow-runner.js",
    "fluent-flow-connector": "./bin/fluent-flow-connector.js"
  },
  "main": "src/runner.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p jsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@fluent-flow/db": "0.0.1",
