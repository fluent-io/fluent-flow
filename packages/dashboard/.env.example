DATABASE_URL=postgresql://fluentflow:password@localhost:5432/fluentflow
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Collaboration API proxy (same-origin /api/collab/v1 -> Express collab router).
# Shared HMAC secret with the Fluent Flow server; never exposed to the browser.
FF_COLLAB_AUTH_SECRET=
FF_COLLAB_API_URL=http://127.0.0.1:3847

# Server URL for legacy runner registration commands generated from Agents.
NEXT_PUBLIC_FLUENT_FLOW_URL=http://127.0.0.1:3847

# Opt-in only: name of the client-IP header controlled by a VERIFIED reverse
# proxy. Unset by default — password rate limiting then uses a server-defined
# stable bucket plus per-account limiting server-side.
#FF_TRUSTED_PROXY_CLIENT_HEADER=x-real-client-ip
